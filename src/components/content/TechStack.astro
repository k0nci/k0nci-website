---
interface Props {
  technologies: string[];
  class?: string;
}

const { technologies, class: className = '' } = Astro.props;
---

<div class={`${className} flex flex-wrap justify-center gap-4 md:gap-10`}>
  {
    technologies.map((tech) => (
      <div class="rounded-full border border-white/15 bg-white/8 px-6 py-3 backdrop-blur-xl md:px-9 md:py-5">
        <span class="text-sm font-light tracking-wide md:text-base">{tech}</span>
      </div>
    ))
  }
</div>
