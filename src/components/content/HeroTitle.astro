---
interface Props {
  name: string;
  subtitle: string;
  class?: string;
}

const { name, subtitle, class: className = '' } = Astro.props;
---

<div class={className}>
  <h1
    class="bg-linear-to-b from-white to-gray-300 bg-clip-text pb-4 text-6xl font-thin tracking-widest text-transparent drop-shadow-2xl md:text-7xl"
  >
    {name}
  </h1>
  <p class="text-xl font-light opacity-90 drop-shadow-lg md:text-2xl">{subtitle}</p>
</div>
